generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  groups             Group[]
  groupMembers       GroupMember[]
  bills              Bill[]
  billItemSelections BillItemSelection[]
}

model Group {
  id          String   @id @default(uuid())
  name        String
  createdAt   DateTime @default(now())
  paymentInfo String?

  createdById  String // ID User yang membuat grup
  createdBy    User          @relation(fields: [createdById], references: [id])
  groupMembers GroupMember[]
  bill         Bill?
}

model GroupMember {
  id      String @id @default(uuid())
  userId  String
  groupId String

  user  User  @relation(fields: [userId], references: [id])
  group Group @relation(fields: [groupId], references: [id])
}

model Bill {
  id        String   @id @default(uuid())
  paidById  String
  total     Decimal
  groupId   String   @unique
  createdAt DateTime @default(now())

  group  Group      @relation(fields: [groupId], references: [id])
  paidBy User       @relation(fields: [paidById], references: [id])
  items  BillItem[]
}

model BillItem {
  id     String  @id @default(uuid())
  billId String
  name   String
  price  Decimal

  bill       Bill                @relation(fields: [billId], references: [id])
  selections BillItemSelection[]
}

model BillItemSelection {
  id         String   @id @default(uuid())
  billItemId String
  userId     String
  createdAt  DateTime @default(now())

  billItem BillItem @relation(fields: [billItemId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([billItemId, userId])
}
